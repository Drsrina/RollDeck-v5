-main ApplicationMain 
--macro lime._internal.macros.DefineMacro.run()
-cp /haxelib/lime/7,3,0/src
-D lime=7.3.0
--macro openfl._internal.macros.ExtraParams.include()
-cp /haxelib/openfl/8,9,0/src
-D openfl=8.9.0
-cp /haxelib/msignal/1,2,5
-D msignal=1.2.5
-cp Source
-D tools=7.3.0
-D lime-canvas
-D howlerjs
-D no-compilation
-D openfl-html5
-D lime-webgl
-D lime-dom
-D lime-howlerjs
-D lime-html5
-D html5
-D web
--remap flash:openfl
-js Export/html5/bin/TownGenerator.js
-cp Export/html5/haxe
-D html5
-dce full
-D final
-D js-flatten
-dce full