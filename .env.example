# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# ACCESS_TOKEN: Senha/token de acesso do mestre (opcional; se vazio, permite definir na primeira execução).
ACCESS_TOKEN=

# CORS_ORIGINS: Lista separada por vírgula de origens externas autorizadas (opcional).
CORS_ORIGINS=

# NOTION_API_KEY: Token de integração interna do Notion (opcional, usado apenas no servidor para importar páginas/databases).
NOTION_API_KEY=

# DATABASE_URL: String de conexão PostgreSQL para persistência consolidada multi-usuário (opcional; sem ela usa JSON local em data/).
# Exemplo: postgres://rolldeck:rolldeck_secret@localhost:5432/rolldeck
DATABASE_URL=

